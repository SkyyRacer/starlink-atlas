        </Table_Character>
        
        <Table_Character>
            <local_identifier>FacesTable</local_identifier>
            <offset unit="byte">4551036</offset>
            <records>107506</records>
            <description>
                This spreadsheet links vertices into    
                triangular polygon faces without the use of texture coordinates.      
                Each face is defined by three vertex (v1 v2 v3) and vertex-normal     
                (vn1 vn2 vn3) pairs. Pairs are linked as follows:                     
                
                v1//vn1 v2//vn2 v3//vn3
            </description>
            <record_delimiter>Carriage-Return Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">42</record_length>
                
                <Field_Character>
                    <name>Faces_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">1</field_length>
                    <field_format>%1s</field_format>
                    <description>
                        The letter 'f', indicating this record  
                        contains the indices of three vertex and vertex-normal pairs. The     
                        three pairs define a single, triangular polygon face.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>Faces_1</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">3</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">12</field_length>
                    <field_format>%-12s</field_format>
                    <description>First vertex and vertex-normal pair.</description>
                </Field_Character>
                
                <Field_Character>
                    <name>Faces_2</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">16</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">12</field_length>
                    <field_format>%-12s</field_format>
                    <description>Second vertex and vertex-normal pair.</description>
                </Field_Character>
                
                <Field_Character>
                    <name>Faces_3</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">29</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">12</field_length>
                    <field_format>%-12s</field_format>
                    <description>Third vertex and vertex-normal pair.</description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
