                    <field_length unit="byte">7</field_length>
                    <field_format>%7.4f</field_format>
                    <unit>km</unit>
                    <description>X component of the vertex normal.</description>
                </Field_Character>
                
                <Field_Character>
                    <name>Y</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">12</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">7</field_length>
                    <field_format>%7.4f</field_format>
                    <unit>km</unit>
                    <description>Y component of the vertex normal.</description>
                </Field_Character>
                
                <Field_Character>
