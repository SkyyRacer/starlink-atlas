    <File_Area_Observational>
        <File>
            <file_name>mu69_merged.obj</file_name>
            <comment>
                This is a 'merged', high-polygon          
                shape model of Kuiper Belt Object (KBO) 2014 MU69 (Arrokoth) with         
                107506 polygon faces. The model was created based on data from the New    
                Horizons LORRI and MVIC instruments following a fly-by on January 1,      
                2019.                                                                     
                
                The asp-ca04-06-icp-smooth.obj and mu69_fr2kf_hipoly.obj                  
                shape models were manually joined by adding additional polygons,          
                after avoiding overlap by eroding the ventral surface of the              
                mu69_fr2kf_hipoly.obj polygons. Local smoothing was applied to the        
                seams and to the 'neck' region of Arrokoth. The +Z part of the neck       
                was left as a cusp. This model is discussed in Beyer, et al. (2019) and        
                is also a Supplemental Material download for Spencer, et al. (2020). 
            </comment>
        </File>
        
        <Header>
            <offset unit="byte">0</offset>
            <object_length unit="byte">42</object_length>
            <parsing_standard_id>7-Bit ASCII Text</parsing_standard_id>
            <description>
                The first line of the data file contains the letter 'o' 
                followed by the shape model identifier.
            </description>
        </Header>
        
        <Table_Character>
            <local_identifier>VertexTable</local_identifier>
            <offset unit="byte">42</offset>
            <records>53755</records>
            <record_delimiter>Carriage-Return Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">42</record_length>
                
                <Field_Character>
                    <name>Vertex_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">1</field_length>
                    <field_format>%1s</field_format>
                    <description>
                        The letter 'v', indicating this record  
                        contains the X, Y, Z coordinates of a vertex.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>X</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">3</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <field_format>%10.6f</field_format>
                    <unit>km</unit>
                    <description>X coordinate of the vertex</description>
                </Field_Character>
                
                <Field_Character>
                    <name>Y</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">14</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <field_format>%10.6f</field_format>
                    <unit>km</unit>
                    <description>Y coordinate of the vertex</description>
                </Field_Character>
                
                <Field_Character>
                    <name>Z</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">25</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <field_format>%10.6f</field_format>
                    <unit>km</unit>
                    <description>Z coordinate of the vertex</description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
        
        <Table_Character>
            <local_identifier>VertexNormalTable</local_identifier>
            <offset unit="byte">2257752</offset>
            <records>54602</records>
            <record_delimiter>Carriage-Return Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">42</record_length>
                
                <Field_Character>
                    <name>Vertex_Normal_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">2</field_length>
                    <field_format>%2s</field_format>
                    <description>
                        The letters 'vn', indicating this       
                        record is a vertex normal.
                    </description>
                </Field_Character>
                
                <Field_Character>
                    <name>X</name>
                    <field_number>2</field_number>
